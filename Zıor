<body>
  <!-- Skip link -->
  <a class="skip-link" href="#main">İçeriğe geç</a>

  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="#hero" aria-label="Zior Ana Sayfa">
        <img src="/assets/logo.svg" alt="Zior logosu" width="120" height="28" />
      </a>

      <nav class="nav" aria-label="Ana menü">
        <button id="menuToggle" class="hamburger" aria-expanded="false" aria-controls="primaryMenu">
          <span class="sr-only">Menüyü aç/kapat</span>
          ☰
        </button>
        <ul id="primaryMenu" class="menu">
          <li><a href="#koleksiyon">Koleksiyon</a></li>
          <li><a href="#hakkimizda">Hakkımızda</a></li>
          <li><a href="#magazalar">Mağazalar</a></li>
          <li><a href="#iletisim">İletişim</a></li>
        </ul>

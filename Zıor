  {
    "@context":"https://schema.org",
    "@type":"Organization",
    "name":"Zior",
    "url":"https://www.zior.com/",
    "logo":"https://www.zior.com/assets/logo.svg",
    "sameAs":[
      "https://instagram.com/zior",
      "https://www.facebook.com/zior",

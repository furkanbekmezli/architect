:root {
  --bg: #ffffff;
  --text: #0f172a;
  --muted: #475569;
  --primary: #111827;
  --accent: #0ea5e9;
  --surface: #f1f5f9;
  --ring: rgba(14,165,233,.35);
  --radius: 12px;
}

:root[data-theme="dark"] {
  --bg: #0b1020;
  --text: #e5e7eb;
  --muted: #9aa3b2;
  --primary: #e5e7eb;
  --accent: #38bdf8;
  --surface: #111827;
  --ring: rgba(56,189,248,.35);
}

* { box-sizing: border-box; }
html, body { height: 100%; }
body {
  margin: 0;
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", "Apple Color Emoji","Segoe UI Emoji";
  background: var(--bg);
  color: var(--text);
  line-height: 1.55;
}

img { max-width: 100%; display: block; border-radius: var(--radius); }
a { color: inherit; text-decoration: none; }
a:focus { outline: 2px solid var(--ring); outline-offset: 2px; }
button, input, select, textarea { font: inherit; }

.container { width: min(1120px, 92%); margin-inline: auto; }

.skip-link {
  position: absolute; left: -9999px; top: auto;
}
.skip-link:focus { left: 16px; top: 16px; background: var(--surface); padding: 8px 12px; border-radius: 8px; }

.site-header {
  position: sticky; top: 0; z-index: 50; backdrop-filter: blur(8px);
  background: color-mix(in oklab, var(--bg) 75%, transparent);
  border-bottom: 1px solid color-mix(in oklab, var(--muted) 25%, transparent);
}
.header-inner { display: grid; grid-template-columns: auto 1fr auto; gap: 12px; align-items: center; padding: 12px 0; }
.brand img { display: block; }

.nav .menu { display: flex; gap: 18px; list-style: none; margin: 0; padding: 0; }
.nav a { padding: 8px 10px; border-radius: 8px; }
.nav a:hover { background: var(--surface); }

.hamburger { display: none; background: transparent; border: 0; font-size: 22px; }

.actions { display: flex; gap: 8px; align-items: center; }
.btn-icon { border: 1px solid color-mix(in oklab, var(--muted) 30%, transparent); background: var(--surface); border-radius: 10px; padding: 8px 10px; cursor: pointer; }
.btn-icon[data-count]:after {
  content: attr(data-count); font-size: 11px; background: var(--accent); color: #fff; border-radius: 999px; padding: 2px 6px; margin-left: 6px;
}

.hero { padding: 36px 0 18px; }
.hero-inner { display: grid; grid-template-columns: 1.1fr .9fr; align-items: center; gap: 28px; }
.hero-copy h1 { font-size: clamp(28px, 4vw, 44px); margin: 0 0 8px; }
.hero-copy p { color: var(--muted); margin: 0 0 18px; }
.hero-cta { display: flex; gap: 12px; }
.btn { display: inline-block; padding: 12px 16px; border-radius: 12px; border: 1px solid transparent; cursor: pointer; }
.btn-primary { background: var(--text); color: var(--bg); }
.btn-primary:hover { opacity: .9; }
.btn-outline { border-color: color-mix(in oklab, var(--muted) 35%, transparent); background: transparent; }
.btn-outline:hover { background: var(--surface); }

.filters { padding: 12px 0 0; }
.filter-row { display: grid; grid-template-columns: 1fr 180px 180px; gap: 12px; }
input[type="search"], select, input[type="email"], input[type="text"], textarea {
  width: 100%; padding: 12px 14px; border-radius: 10px; border: 1px solid color-mix(in oklab, var(--muted) 35%, transparent); background: var(--bg); color: var(--text);
}
.chips { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 10px; }
.chip { padding: 8px 12px; border-radius: 999px; background: var(--surface); border: 1px solid color-mix(in oklab, var(--muted) 25%, transparent); cursor: pointer; }
.chip.active { outline: 2px solid var(--ring); }

.collection { padding: 22px 0 36px; }
.collection h2 { margin-bottom: 12px; }
.grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
.card {
  background: var(--surface); border: 1px solid color-mix(in oklab, var(--muted) 20%, transparent);
  border-radius: 16px; overflow: hidden; display: flex; flex-direction: column;
}
.card-body { padding: 12px; display: grid; gap: 6px; }
.card h3 { font-size: 16px; margin: 0; }
.price { display: flex; gap: 8px; align-items: baseline; }
.price .old { color: var(--muted); text-decoration: line-through; font-size: 14px; }
.badges { display: flex; gap: 6px; flex-wrap: wrap; }
.badge { font-size: 11px; padding: 4px 8px; border: 1px solid color-mix(in oklab, var(--muted) 30%, transparent); border-radius: 999px; }
.card .actions { margin-top: 6px; display: flex; gap: 8px; }
.card .btn { width: 100%; }

.empty { text-align: center; color: var(--muted); padding: 16px; border: 1px dashed color-mix(in oklab, var(--muted) 35%, transparent); border-radius: 12px; }

.about, .stores, .contact { padding: 32px 0; }
.values { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; padding-left: 18px; }
.store-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
.store-card { background: var(--surface); border: 1px solid color-mix(in oklab, var(--muted) 20%, transparent); padding: 12px; border-radius: 12px; }

.newsletter { background: linear-gradient(180deg, color-mix(in oklab, var(--surface) 70%, transparent), transparent); padding: 28px 0; }
.newsletter-inner { display: grid; gap: 8px; }
.nl-form { display: flex; gap: 8px; flex-wrap: wrap; }
#nlMsg, #contactMsg { margin-left: 8px; color: var(--muted); }

.contact-form .row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.field { display: grid; gap: 6px; }

.site-footer { border-top: 1px solid color-mix(in oklab, var(--muted) 20%, transparent); padding: 24px 0; margin-top: 24px; }
.footer-grid { display: grid; grid-template-columns: 1fr auto auto; gap: 16px; align-items: start; }
.footer-links { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
.socials a { font-size: 20px; margin-right: 8px; }

.modal { border: 0; border-radius: 16px; padding: 0; width: min(960px, 92%); }
.modal::backdrop { background: rgba(0,0,0,.5); }
.modal-body { padding: 12px; }
.modal-close { position: absolute; right: 12px; top: 6px; border: 0; background: transparent; font-size: 28px; cursor: pointer; }

@media (max-width: 980px) {
  .hero-inner { grid-template-columns: 1fr; }
  .grid { grid-template-columns: repeat(2, 1fr); }
  .store-grid { grid-template-columns: 1fr; }
  .values { grid-template-columns: 1fr; }
}

@media (max-width: 720px) {
  .nav .menu { display: none; position: absolute; right: 0; top: 60px; background: var(--bg); padding: 12px; border-radius: 12px; border: 1px solid color-mix(in oklab, var(--muted) 25%, transparent); }
  .hamburger { display: inline-block; }
  .filter-row { grid-template-columns: 1fr; }
  .contact-form .row { grid-template-columns: 1fr; }
}

.sr-only {
  position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
  overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
}


(function () {
  const $ = (s, c = document) => c.querySelector(s);
  const $$ = (s, c = document) => [...c.querySelectorAll(s)];

  const productGrid = $("#productGrid");
  const emptyState = $("#emptyState");
  const searchInput = $("#searchInput");
  const categorySelect = $("#categorySelect");
  const sortSelect = $("#sortSelect");
  const cartBtn = $("#cartBtn");
  const themeToggle = $("#themeToggle");
  const chips = $$(".chip");

  const menuToggle = $("#menuToggle");
  const primaryMenu = $("#primaryMenu");

  const productModal = $("#productModal");
  const modalClose = productModal?.querySelector(".modal-close");
  const modalBody = $("#modalBody");
  const newsletterForm = $("#newsletterForm");
  const nlEmail = $("#nlEmail");
  const nlMsg = $("#nlMsg");
  const contactForm = $("#contactForm");
  const contactMsg = $("#contactMsg");

  const state = {
    query: "",
    category: "",
    chip: "",
    sort: "featured",
    cartCount: Number(localStorage.getItem("zior-cart-count") || 0),
    products: window.ZIOR_PRODUCTS || []
  };

  // Yıl
  const yearEl = $("#year");
  if (yearEl) yearEl.textContent = new Date().getFullYear();

  // Tema
  themeToggle?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("zior-theme", next);
  });

  // Menü
  menuToggle?.addEventListener("click", () => {
    const open = primaryMenu.style.display === "block";
    primaryMenu.style.display = open ? "none" : "block";
    menuToggle.setAttribute("aria-expanded", String(!open));
  });

  // Sepet sayacı
  const updateCart = (delta = 0) => {
    state.cartCount = Math.max(0, state.cartCount + delta);
    localStorage.setItem("zior-cart-count", String(state.cartCount));
    cartBtn?.setAttribute("data-count", String(state.cartCount));
  };
  updateCart(0);

  // Filtreler
  searchInput?.addEventListener("input", e => {
    state.query = e.target.value.toLowerCase().trim();
    render();
  });

  categorySelect?.addEventListener("change", e => {
    state.category = e.target.value;
    render();
  });

  sortSelect?.addEventListener("change", e => {
    state.sort = e.target.value;
    render();
  });

  chips.forEach(chip => {
    chip.addEventListener("click", () => {
      chips.forEach(c => c.classList.remove("active"));
      if (state.chip === chip.dataset.chip) {
        state.chip = "";
      } else {
        state.chip = chip.dataset.chip;
        chip.classList.add("active");
      }
      render();
    });
  });

  // Ürün kartı oluşturma
  function productCard(p) {
    const price = p.oldPrice
      ? `<div class="price"><strong>${formatTRY(p.price)}</strong><span class="old">${formatTRY(p.oldPrice)}</span></div>`
      : `<div class="price"><strong>${formatTRY(p.price)}</strong></div>`;

    const badges = (p.badges || [])
      .map(b => `<span class="badge">${capitalize(b)}</span>`).join("");

    return `
      <article class="card" tabindex="0" aria-labelledby="title-${p.id}">
        <img src="${p.images?.[0] || '/assets/hero-placeholder.jpg'}" alt="${p.title}" loading="lazy" />
        <div class="card-body">
          <h3 id="title-${p.id}">${p.title}</h3>
          <div class="badges">${badges}</div>
          ${price}
          <div class="actions">
            <button class="btn btn-outline" data-quick="${p.id}">Hızlı Gör</button>
            <button class="btn btn-primary" data-add="${p.id}">Sepete Ekle</button>
          </div>
        </div>
      </article>
    `;
  }

  // Sıralama
  function sortProducts(list) {
    if (state.sort === "price-asc") return list.sort((a,b)=>a.price-b.price);
    if (state.sort === "price-desc") return list.sort((a,b)=>b.price-a.price);
    if (state.sort === "newest") return list.sort((a,b)=>new Date(b.createdAt)-new Date(a.createdAt));
    return list; // featured
  }

  // Filtreleme
  function filterProducts() {
    let list = [...state.products];
    if (state.query) {
      list = list.filter(p =>
        p.title.toLowerCase().includes(state.query) ||
        p.category.toLowerCase().includes(state.query)
      );
    }
    if (state.category) list = list.filter(p => p.category === state.category);
    if (state.chip) list = list.filter(p => (p.badges || []).includes(state.chip));
    return sortProducts(list);
  }

  // Render
  function render() {
    const list = filterProducts();
    productGrid.innerHTML = list.map(productCard).join("");
    emptyState.hidden = list.length > 0;

    // Buton bağla
    $$("#productGrid [data-add]").forEach(btn => {
      btn.addEventListener("click", () => {
        const id = btn.dataset.add;
        const product = state.products.find(p=>p.id===id);
        if (product) {
          updateCart(1);
          btn.textContent = "Eklendi ✓";
          setTimeout(()=>btn.textContent="Sepete Ekle", 1500);
        }
      });
    });

    $$("#productGrid [data-quick]").forEach(btn => {
      btn.addEventListener("click", () => openModal(btn.dataset.quick));
    });
  }

  // Modal
  function openModal(id) {
    const p = state.products.find(x=>x.id===id);
    if (!p) return;
    modalBody.innerHTML = `
      <div class="product-detail">
        <div class="pd-media">
          ${(p.images||[]).map(src=>`<img src="${src}" alt="${p.title}" />`).join("")}
        </div>
        <div class="pd-info">
          <h3>${p.title}</h3>
          <p>Kategori: ${p.category} • ⭐ ${p.rating || "5.0"}</p>
          <div class="price">${p.oldPrice?`<span class="old">${formatTRY(p.oldPrice)}</span>`:""} <strong>${formatTRY(p.price)}</strong></div>
          <div class="pd-opts">
            <label>Renk:
              <select>${(p.colors||[]).map(c=>`<option>${c}</option>`).join("")}</select>
            </label>
            <label>Beden:
              <select>${(p.sizes||[]).map(s=>`<option>${s}</option>`).join("")}</select>
            </label>
          </div>
          <button class="btn btn-primary" id="modalAdd">Sepete Ekle</button>
        </div>
      </div>
      <style>
        .product-detail { display:grid; grid-template-columns: 1.1fr .9fr; gap:16px; }
        .pd-media { display:grid; gap:8px; }
        .pd-opts { display:grid; gap:8px; margin:8px 0; }
        @media (max-width: 860px){ .product-detail { grid-template-columns: 1fr; } }
      </style>
    `;
    $("#modalAdd", modalBody)?.addEventListener("click", () => updateCart(1));
    productModal.showModal();
  }
  modalClose?.addEventListener("click", ()=> productModal.close());
  productModal?.addEventListener("click", e => {
    const rect = productModal.getBoundingClientRect();
    if (e.clientX < rect.left || e.clientX > rect.right || e.clientY < rect.top || e.clientY > rect.bottom) {
      productModal.close();
    }
  });

  // Bülten (sahte doğrulama)
  newsletterForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!nlEmail.value || !/.+@.+\..+/.test(nlEmail.value)) {
      nlMsg.textContent = "Lütfen geçerli bir e-posta girin.";
      return;
    }
    nlMsg.textContent = "Teşekkürler! E-postanı kontrol et.";
    newsletterForm.reset();
  });

  // İletişim (sahte)
  contactForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    contactMsg.textContent = "Mesajınız alındı. 24 saat içinde dönüş yapacağız.";
    contactForm.reset();
  });

  // Yardımcılar
  function formatTRY(n) {
    try { return new Intl.NumberFormat('tr-TR',{style:'currency',currency:'TRY'}).format(n); }
    catch { return n + " TL"; }
  }
  function capitalize(s){ return s.charAt(0).toUpperCase()+s.slice(1); }

  // Başlat
  render();

  // Service Worker kaydı
  if ("serviceWorker" in navigator) {
    navigator.serviceWorker.register("/sw.js").catch(()=>{});
  }
})();

